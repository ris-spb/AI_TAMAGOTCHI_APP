# AI Tamagotchi Stage 13 example — NO REAL SECRETS
APP_ENV=local
NODE_ENV=development
APP_HOST=0.0.0.0
APP_PORT=3000
APP_PUBLIC_ORIGIN=http://localhost:5173
APP_BUSINESS_TIMEZONE=Europe/Moscow
APP_DEFAULT_LOCALE=ru
API_BASE_PATH=/v1
VITE_API_BASE_PATH=/v1
VITE_APP_ENV_LABEL=local

DATABASE_URL=__INJECT_AT_RUNTIME__
REDIS_URL=__INJECT_AT_RUNTIME__
QUEUE_PREFIX=ai-tamagotchi
WORKER_CONCURRENCY=2

AUTH_SESSION_TTL_SECONDS=28800
AUTH_SESSION_IDLE_TTL_SECONDS=
AUTH_SESSION_TOKEN_PEPPER_REF=
AUTH_RATE_LIMIT_POLICY_REF=stage14

INTEGRATIONS_PERSONNEL_PROVIDER_KEY=mock
PERSONNEL_BASE_URL=
PERSONNEL_CREDENTIAL_REF=
PERSONNEL_TIMEOUT_MS=10000
PERSONNEL_MAX_ATTEMPTS=2
PERSONNEL_RETRY_BACKOFF_MS=500
PERSONNEL_SYNC_ENABLED=false
PERSONNEL_SYNC_SCHEDULE=

INTEGRATIONS_LLM_PROVIDER_KEY=mock
LLM_BASE_URL=
LLM_CREDENTIAL_REF=
LLM_TIMEOUT_MS=60000
LLM_MAX_ATTEMPTS=2
LLM_RETRY_BACKOFF_MS=1000
LLM_MODEL_ID=mock-deterministic

INTEGRATIONS_STT_PROVIDER_KEY=mock
STT_BASE_URL=
STT_CREDENTIAL_REF=
STT_TIMEOUT_MS=60000
STT_MAX_ATTEMPTS=2
STT_RETRY_BACKOFF_MS=1000
STT_MODEL_ID=mock-deterministic

INTEGRATIONS_WEATHER_ENABLED=false
INTEGRATIONS_WEATHER_PROVIDER_KEY=
WEATHER_BASE_URL=
WEATHER_CREDENTIAL_REF=
WEATHER_LOCATION_KEY=saint_petersburg
WEATHER_TIMEOUT_MS=5000
WEATHER_MAX_ATTEMPTS=1
WEATHER_CACHE_TTL_SECONDS=900

INTEGRATIONS_OBJECT_STORAGE_PROVIDER_KEY=mock
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_CREDENTIAL_REF=
OBJECT_STORAGE_PREFIX_EXPORTS=exports/
OBJECT_STORAGE_TIMEOUT_MS=30000
OBJECT_STORAGE_MAX_ATTEMPTS=2
EXPORT_ARTIFACT_TTL_SECONDS=

INTEGRATIONS_EXTERNAL_NOTIFICATIONS_ENABLED=false
EXTERNAL_NOTIFICATION_PROVIDER_KEY=
EXTERNAL_NOTIFICATION_BASE_URL=
EXTERNAL_NOTIFICATION_CREDENTIAL_REF=

GAME_RULES_VERSION=game_rules_v1.0-baseline.stage7

FF_REALTIME_3D=true
FF_DYNAMIC_LIGHTING_VARIANTS=false
FF_KTX2=false
ASSET_FINAL_PRODUCTION_3D_AVAILABLE=false
FF_VOICE_STT=true
FF_IN_APP_NOTIFICATIONS=true
FF_AMBIENT_CONTEXT=true
FF_EXPORTS=true

# HARD_DISABLED_MVP flags are validated from feature_flags.json as false.
# NEVER put secrets in VITE_*.
