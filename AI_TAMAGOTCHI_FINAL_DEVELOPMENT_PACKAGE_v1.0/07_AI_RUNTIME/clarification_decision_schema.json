{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-tamagotchi:clarification-decision:v1.0",
  "title": "ClarificationDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "required",
    "reason",
    "question",
    "expected_information_gain"
  ],
  "properties": {
    "required": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "enum": [
        "none",
        "plausibility",
        "duplicate",
        "complexity",
        "missing_data"
      ]
    },
    "question": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "expected_information_gain": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 400
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "required": {
            "const": true
          }
        },
        "required": [
          "required"
        ]
      },
      "then": {
        "properties": {
          "reason": {
            "not": {
              "const": "none"
            }
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "expected_information_gain": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "required": {
            "const": false
          }
        },
        "required": [
          "required"
        ]
      },
      "then": {
        "properties": {
          "reason": {
            "const": "none"
          },
          "question": {
            "type": "null"
          },
          "expected_information_gain": {
            "type": "null"
          }
        }
      }
    }
  ]
}
