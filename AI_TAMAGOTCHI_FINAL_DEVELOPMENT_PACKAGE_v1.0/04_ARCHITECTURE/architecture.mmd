    API --> Auth
    API --> Personnel
    API --> Profile
    API --> Case
    API --> Rank
    API --> Analytics
    API --> Export
    API --> Notif

    Case --> Task
    Case --> AI
    Case --> Prog
    Case --> Goals
    Case --> Audit
    AI --> Tax

    API --> DB
    Worker --> DB
    Worker --> Redis
    DB -->|"transactional outbox"| Worker

    Worker --> AI
    Worker --> Prog
    Worker --> Goals
    Worker --> Analytics
    Worker --> Notif
    Worker --> Export
    Worker --> Personnel

    Personnel --> PersonnelP
    AI --> LLMP
    AI --> STTP
    Worker --> WeatherP
    Export --> Storage

    API --> Telemetry
    Worker --> Telemetry

    Rank --> DB
    Analytics --> DB
    Scene -. no direct business writes .-> UI
